# ============================================
# BlivoAI Production Environment Variables
# ============================================
# Copy this file to .env and fill in all values.
# DO NOT commit .env to Git.
# chmod 600 .env
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=blivoai
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=blivoai

# --- Database URL (constructed from POSTGRES_* if not set) ---
# Override only if connecting to an EXTERNAL database.
# For the local db service, leave this commented out.
# DATABASE_URL=postgresql://blivoai:PASSWORD@db:5432/blivoai?schema=public

# --- Authentication ---
JWT_SECRET=GENERATE_A_RANDOM_64_HEX_STRING
NEXTAUTH_SECRET=GENERATE_ANOTHER_RANDOM_64_HEX_STRING
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Cron ---
CRON_SECRET=GENERATE_A_RANDOM_64_HEX_STRING

# --- Internal Security ---
INTERNAL_SECURITY_KEY=GENERATE_A_RANDOM_64_HEX_STRING

# --- Payments (Dodo) ---
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_API_BASE_URL=https://live.dodopayments.com
DODO_IS_LIVE=false

# --- Email (Resend) ---
RESEND_API_KEY=


# --- LLM ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL_LIGHT=
LLM_MODEL_MEDIUM=
LLM_MODEL_HEAVY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- Public ---
NEXT_PUBLIC_SITE_URL=https://blivoai.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXTAUTH_URL=https://blivoai.com
